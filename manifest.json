{
  "manifest_version": 3,
  "version": "1.7.0",
  "name": "Shipping Optimizer",
  "short_name": "Shipping Optimizer",
  "description": "Generate image variants, check live Meesho shipping, preview results, and apply the best image to your catalog.",
  "author": "Deepanshu Arora",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "identity"
  ],
  "oauth2": {
    "client_id": "860976240598-lfncv478meb0hel45vr3elf8fu5muv17.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "*://supplier.meesho.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://us-central1-extension-e6e32.cloudfunctions.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://supplier.meesho.com/panel/*",
        "*://supplier.meesho.com/panel/*/cataloging/*/catalogs/single/*",
        "*://supplier.meesho.com/panel/*/cataloging/*",
        "*://supplier.meesho.com/cataloging/*",
        "*://supplier.meesho.com/catalogs/single/*"
      ],
      "js": ["js/staticComposeLoader.mjs"],
      "type": "module",
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://supplier.meesho.com/panel/*",
        "*://supplier.meesho.com/panel/*/cataloging/*/catalogs/single/*",
        "*://supplier.meesho.com/panel/*/cataloging/*",
        "*://supplier.meesho.com/cataloging/*",
        "*://supplier.meesho.com/catalogs/single/*"
      ],
      "js": [
        "config.js",
        "js/firebaseLicense.js",
        "js/firebaseAuth.js",
        "js/machineId.js",
        "js/utils.js",
        "js/whatsappLink.js",
        "js/license.js",
        "js/meeshoCategories.js",
        "js/meeshoApi.js",
        "js/imageGenerator.js",
        "js/ui.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shipping Optimizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config.js",
        "js/*.js",
        "js/*.mjs",
        "js/lib/*.mjs",
        "data/*.json",
        "Badge/*.png",
        "icons/*.png"
      ],
      "matches": ["*://supplier.meesho.com/*"]
    }
  ],
  "offline_enabled": true,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
